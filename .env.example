# Copy this file to .env (never commit .env) and change the passwords.
MYSQL_ROOT_PASSWORD=change-me-root
OFICIALIA_DB_PASSWORD=change-me-oficialia
PERITOS_DB_PASSWORD=change-me-peritos
AUDIENCIAS_DB_PASSWORD=change-me-audiencias
TOCAS_DB_PASSWORD=change-me-tocas

# Oficialía: first accounts, created only while its users table is empty (see docs/base-de-datos.md).
# The judicial body administrator; the password needs 8+ characters with letters and numbers.
OFICIALIA_ADMIN_EMAIL=admin@example.com
OFICIALIA_ADMIN_PASSWORD=change-me-2026
# Development only: also load the demo accounts (the team shares their password privately)
OFICIALIA_SAMPLE_USERS=true
