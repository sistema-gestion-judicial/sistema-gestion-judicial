<%-- Floating sidebar of the Oficialía de Partes and the greeting row above every page (Figma "Sidebar" frame).
     The including page sets activeNav to mark its menu entry. Each role has its own entries; those marked
     "Pronto" have no page yet, so they carry no link. --%>
<c:set var="navRole" value="${sessionScope.currentUser.role}" />
<c:set var="navRequests">
  <li>
    <a class="app-nav-link ${activeNav == 'requests' ? 'active' : ''}" href="${ctx}/demand-requests">
      <i class="bi bi-file-earmark-text"></i> Solicitudes
    </a>
  </li>
</c:set>
<c:set var="navCaseFiles">
  <li>
    <span class="app-nav-link is-soon" title="Disponible en un siguiente avance">
      <i class="bi bi-folder2"></i> Expedientes <span class="soon-tag">Pronto</span>
    </span>
  </li>
</c:set>
<c:set var="navCourts">
  <li>
    <a class="app-nav-link ${activeNav == 'courts' ? 'active' : ''}" href="${ctx}/courts">
      <i class="bi bi-bank"></i> Juzgados
    </a>
  </li>
</c:set>
<body>
<div class="app-shell">
  <aside class="app-sidebar">
    <div class="app-brand">
      <div class="app-brand-logo" role="img" aria-label="Sistema de Control de Demandas"></div>
      <div class="app-brand-name">SCD</div>
      <div class="app-brand-area">Oficialía de Partes</div>
    </div>

    <ul class="app-nav">
      <c:choose>
        <%-- DEMO (temporary): the judicial body administrator gets the Oficial de Partes menu --%>
        <c:when test="${navRole == 'CLERK' or navRole == 'JUDICIAL_BODY_ADMIN'}">
          <li>
            <a class="app-nav-link ${activeNav == 'new-request' ? 'active' : ''}" href="${ctx}/demand-requests/new">
              <i class="bi bi-file-earmark-plus"></i> Registrar solicitud
            </a>
          </li>
          ${navRequests}
          ${navCaseFiles}
          <c:if test="${navRole == 'JUDICIAL_BODY_ADMIN'}">
            <li>
              <a class="app-nav-link ${activeNav == 'districts' ? 'active' : ''}" href="${ctx}/judicial-districts">
                <i class="bi bi-geo-alt"></i> Distritos judiciales
              </a>
            </li>
          </c:if>
          ${navCourts}
        </c:when>
        <c:when test="${navRole == 'COURT_ADMIN'}">
          <li>
            <a class="app-nav-link ${activeNav == 'users' ? 'active' : ''}" href="${ctx}/users">
              <i class="bi bi-people"></i> Usuarios
            </a>
          </li>
          ${navCourts}
          ${navRequests}
          ${navCaseFiles}
        </c:when>
        <c:otherwise>
          <li>
            <a class="app-nav-link ${activeNav == 'districts' ? 'active' : ''}" href="${ctx}/judicial-districts">
              <i class="bi bi-geo-alt"></i> Distritos judiciales
            </a>
          </li>
          ${navCourts}
        </c:otherwise>
      </c:choose>
    </ul>

    <div class="app-sidebar-footer">
      <form method="post" action="${ctx}/logout" data-sign-out>
        <button type="submit" class="app-nav-link border-0">
          <span class="icon-sign-out" aria-hidden="true"></span> Cerrar sesión
        </button>
      </form>
    </div>
  </aside>

  <main class="app-main">
    <%-- "Barra superior" of the Tocas design: system and area, breadcrumb, and the profile that opens the user menu.
         Oficialía has no notifications, so the notifications pill of the design is left out. --%>
    <header class="app-bar">
      <div class="app-bar-brand">
        <span class="app-bar-system">SCD</span>
        <span class="app-bar-area">Oficialía de Partes</span>
      </div>
      <span class="app-bar-divider" aria-hidden="true"></span>
      <nav class="app-bar-breadcrumb" aria-label="Ruta de navegación">
        <c:choose>
          <c:when test="${pageTitle == 'Inicio'}">
            <span aria-current="page">Inicio</span>
          </c:when>
          <c:otherwise>
            <a href="${ctx}/home">Inicio</a>
            <span class="app-bar-separator" aria-hidden="true">›</span>
            <span aria-current="page"><c:out value="${pageTitle}" /></span>
          </c:otherwise>
        </c:choose>
      </nav>
      <div class="app-bar-end">
        <span class="app-bar-divider" aria-hidden="true"></span>
        <%@ include file="/WEB-INF/views/layout/user-chip.jspf" %>
      </div>
    </header>
