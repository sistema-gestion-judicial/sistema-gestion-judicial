<%-- Sidebar of the Oficialía de Partes. The including page sets activeNav to mark its menu entry.
     Each role has its own entries; those marked "Pronto" have no page yet, so they carry no link. --%>
<c:set var="navRole" value="${sessionScope.currentUser.role}" />
<c:set var="navRequests">
  <li>
    <a class="app-nav-link ${activeNav == 'requests' ? 'active' : ''}" href="${ctx}/demand-requests">
      <i class="bi bi-file-earmark-text"></i> Solicitudes
    </a>
  </li>
</c:set>
<c:set var="navCaseFiles">
  <li>
    <span class="app-nav-link is-soon" title="Disponible en un siguiente avance">
      <i class="bi bi-folder2"></i> Expedientes <span class="soon-tag">Pronto</span>
    </span>
  </li>
</c:set>
<c:set var="navCourts">
  <li>
    <span class="app-nav-link is-soon" title="Disponible en un siguiente avance">
      <i class="bi bi-bank"></i> Juzgados <span class="soon-tag">Pronto</span>
    </span>
  </li>
</c:set>
<body>
<div class="app-shell">
  <aside class="app-sidebar">
    <div class="app-brand">
      <div class="app-brand-logo">SCD</div>
      <div>
        <div class="app-brand-name">Sistema de Control de Demandas</div>
        <div class="app-brand-area">Oficialía de Partes</div>
      </div>
    </div>

    <ul class="app-nav">
      <c:choose>
        <c:when test="${navRole == 'CLERK'}">
          <li>
            <a class="app-nav-link ${activeNav == 'new-request' ? 'active' : ''}" href="${ctx}/demand-requests/new">
              <i class="bi bi-file-earmark-plus"></i> Registrar solicitud
            </a>
          </li>
          ${navRequests}
          ${navCaseFiles}
          ${navCourts}
        </c:when>
        <c:when test="${navRole == 'COURT_ADMIN'}">
          <li>
            <a class="app-nav-link ${activeNav == 'users' ? 'active' : ''}" href="${ctx}/users">
              <i class="bi bi-people"></i> Usuarios
            </a>
          </li>
          ${navCourts}
          ${navRequests}
          ${navCaseFiles}
        </c:when>
        <c:otherwise>
          ${navCourts}
        </c:otherwise>
      </c:choose>
    </ul>
  </aside>

  <main class="app-main">
